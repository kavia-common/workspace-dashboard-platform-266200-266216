# FastAPI backend environment variables
# Ask the orchestrator/user to set these in the real .env (do not commit secrets).

# REQUIRED: Postgres connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/workspace_dashboard

# REQUIRED: JWT signing secret (use a long random string)
JWT_SECRET_KEY=replace_me_with_a_long_random_secret

# OPTIONAL
CORS_ALLOW_ORIGINS=*
ENVIRONMENT=development
